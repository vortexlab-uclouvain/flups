CXX = mpic++
CC  = mpicc

## Compile & linker flags
CXXFLAGS := -fPIC -g -O3 -fopenmp -std=c++17 -Wno-format-security -DPROF
CCFLAGS  := -fPIC -g -O3 -fopenmp -std=c99   -Wno-format-security
LDFLAGS  := -fPIC -g -O3 -fopenmp -lstdc++   -lm

## OpenBLAS
CXXFLAGS += -I/usr/local/openblas/include
LDFLAGS  += -L/usr/local/openblas/lib -lopenblas -lmagma

## GPU-related stuff
OPTS     += -DFLUPS_CUDA_BACKEND
CXXFLAGS += -fopenmp-targets=nvptx64-nvidia-cuda
LDFLAGS  += -fopenmp-targets=nvptx64-nvidia-cuda

## Specify the location of FFTW3 (by default, assumed to be /usr/lib/)
#FFTW_DIR  :=  /usr/local/fftw
#FFTW_LIB := ${FFTW_DIR}/lib
#FFTW_INC := ${FFTW_DIR}/include
FFTW_LIB := /usr/lib/x86_64-linux-gnu

## Specify the location of HDF5 (by default, assumed to be /usr/lib/)
HDF5_INC := /usr/include/hdf5/openmpi
HDF5_LIB := /usr/lib/x86_64-linux-gnu
HDF5_LIBNAME := -lhdf5_openmpi

## Specify the location of H3LPR
H3LPR_INC := /soft/h3lpr/include
H3LPR_LIB := /soft/h3lpr/lib

## Specify the location of Googletest library (by default, assumed to be /usr/lib/)
GTEST_INC := /soft/googletest/include
GTEST_LIB := /soft/googletest/lib


