CXX = mpic++
CC  = mpicc

## Compile & linker flags
CXXFLAGS := -fPIC -g -O3 -fopenmp -std=c++17 -Wno-format-security -DPROF
LDFLAGS  := -fPIC -g -O3 -fopenmp -lstdc++   -lm

## Debug flags
#CXXFLAGS += -DVERBOSE

## GPU-related stuff
OPTS     += -DFLUPS_CUDA_BACKEND
CXXFLAGS += -fopenmp-targets=nvptx64-nvidia-cuda
LDFLAGS  += -fopenmp-targets=nvptx64-nvidia-cuda

## CUDA
CUDA_DIR := /usr/local/cuda
CUDA_LIB := ${CUDA_DIR}/lib64
CUDA_INC := ${CUDA_DIR}/include
CUDA_LIBNAME := -lcudart -lcublas -lcufft

## Specify the location of FFTW3
FFTW_LIB := /usr/lib/x86_64-linux-gnu
FFTW_INC := /usr/include

## Specify the location of HDF5
HDF5_LIB := /usr/lib/x86_64-linux-gnu
HDF5_INC := /usr/include
HDF5_LIBNAME := -lhdf5_openmpi

## Specify the location of H3LPR
H3LPR_DIR := ${HOME}/h3lpr
H3LPR_LIB := ${H3LPR_DIR}/lib
H3LPR_INC := ${H3LPR_DIR}/include

## Specify the location of Googletest library
GTEST_DIR := /soft/googletest
GTEST_LIB := ${GTEST_DIR}/lib
GTEST_INC := ${GTEST_DIR}/include
